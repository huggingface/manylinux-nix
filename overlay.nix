{ nixpkgs-20191230 }:

final: prev:

let
  flattenVersion = prev.lib.strings.replaceStrings [ "." ] [ "_" ];
  readPackageMetadata = path: builtins.fromJSON (builtins.readFile path);

  # Supported manylinux versions. Each version `X.Y` is exposed as the
  # `manylinux_X_Y` package set. A version needs package metadata for every
  # supported architecture in `metadata/` (generated by
  # `scripts/rhel2nix.py`).
  versions = [
    "2.28"
  ];

  mkManylinuxPackages = final.callPackage ./manylinux { inherit nixpkgs-20191230; };
in
builtins.listToAttrs (
  map (version: {
    name = "manylinux_${flattenVersion (prev.lib.versions.majorMinor version)}";
    value = mkManylinuxPackages {
      packageMetadata = readPackageMetadata ./metadata/manylinux-${version}-${prev.stdenv.hostPlatform.uname.processor}-metadata.json;
    };
  }) versions
)
